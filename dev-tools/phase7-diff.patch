+  const SOURCE_END_UTC = '2026-03-02T19:00:00+00:00'; // 13:00 Chicago
+  const EXPECTED_TARGET_START_UTC = '2026-03-08T14:00:00+00:00'; // 09:00 Chicago (CDT, UTC-5), Sunday
+
