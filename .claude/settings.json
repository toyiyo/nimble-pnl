{
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "stripe@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "includeCoAuthoredBy": false,
    "gitAttribution": false
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if printf '%s\\n' \"$TOOL_INPUT\" | grep -q 'git commit'; then echo '--- CodeRabbit Pre-Commit Check ---'; cr_out=$(coderabbit review --agent --uncommitted 2>&1); printf '%s\\n' \"$cr_out\" | head -200; echo '--- End CodeRabbit Check ---'; fi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/post-edit-lint.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/dev-phase-guard.sh",
            "statusMessage": "Checking /dev workflow completion"
          }
        ]
      }
    ]
  }
}
